{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_aoi_cortexdb__(knowledge_save|ingest_document|memory_save|knowledge_update)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${LOCALAPPDATA}/aoi/python/python.exe\" \"${CLAUDE_PLUGIN_ROOT}/convention/convention.py\" garde",
            "timeout": 15,
            "statusMessage": "Contrôle de la convention CortexDB (memo)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${LOCALAPPDATA}/aoi/python/python.exe\" \"${CLAUDE_PLUGIN_ROOT}/convention/convention.py\" miroir",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
