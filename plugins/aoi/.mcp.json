{
  "mcpServers": {
    "rhino": {
      "command": "${LOCALAPPDATA}/aoi/python/python.exe",
      "args": [
        "-I",
        "-S",
        "${CLAUDE_PLUGIN_ROOT}/mcp/rhino/run.py"
      ]
    },
    "revit": {
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp/revit/runtime/node.exe",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/revit/server/build/index.js"
      ]
    },
    "veille": {
      "type": "http",
      "url": "https://veille.casual-labs.ch/mcp",
      "headers": {
        "Authorization": "Bearer ${AOI_VEILLE_TOKEN}"
      }
    }
  }
}
