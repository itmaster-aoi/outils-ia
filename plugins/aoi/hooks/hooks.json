{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/controle/runtime/python.exe\" \"${CLAUDE_PLUGIN_ROOT}/skills/regen/scripts/maj.py\" --demarrage",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_aoi_cortexdb__(knowledge_save|ingest_document|memory_save|knowledge_update)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${LOCALAPPDATA}/aoi/python/python.exe\" \"${CLAUDE_PLUGIN_ROOT}/memo/convention.py\" garde",
            "timeout": 15,
            "statusMessage": "Contrôle de la convention CortexDB (aoi, memo)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${LOCALAPPDATA}/aoi/python/python.exe\" \"${CLAUDE_PLUGIN_ROOT}/memo/convention.py\" miroir",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
