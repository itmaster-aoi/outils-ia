# Avec core.autocrlf=true (Git for Windows), sans ces règles, Claude Code
# clone les SKILL.md en CRLF et leur en-tête YAML ne se lit plus (skills sans nom).
*.md   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# Panneau CEP signé d'Illustrator : un octet changé annule la signature, donc aucune conversion.
plugins/aoi/mcp/illustrator/addin/illustrator-mcp.claude-mcp/** -text
